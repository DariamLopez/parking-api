{
  "info": {
    "_postman_id": "parking-api-collection",
    "name": "Parking API",
    "description": "RESTful API for parking management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    { "key": "auth_token", "value": "", "type": "string" },
    { "key": "user_id", "value": "", "type": "string" },
    { "key": "spot_id", "value": "", "type": "string" },
    { "key": "reservation_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Seed",
      "item": [
        {
          "name": "Run Seed",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/seed",
              "host": ["{{base_url}}"],
              "path": ["seed"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@parking.com\",\n  \"password\": \"Password1!\",\n  \"phone\": \"600123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json(); if(r.token) pm.collectionVariables.set('auth_token', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@parking.com\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Employee)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json(); if(r.token) pm.collectionVariables.set('auth_token', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@parking.com\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json(); if(r.token) pm.collectionVariables.set('auth_token', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"client@parking.com\",\n  \"password\": \"Admin1234!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Check Auth Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/check-auth-status",
              "host": ["{{base_url}}"],
              "path": ["auth", "check-auth-status"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users?limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "offset", "value": "0" },
                { "key": "order", "value": "ASC" }
              ]
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"phone\": \"600999888\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Parking Spots",
      "item": [
        {
          "name": "Get All Spots",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/parking-spot?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["parking-spot"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" },
                { "key": "isActive", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Occupancy",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/parking-spot/occupancy",
              "host": ["{{base_url}}"],
              "path": ["parking-spot", "occupancy"]
            }
          }
        },
        {
          "name": "Get Spot by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/parking-spot/{{spot_id}}",
              "host": ["{{base_url}}"],
              "path": ["parking-spot", "{{spot_id}}"]
            }
          }
        },
        {
          "name": "Create Spot",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"P021\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/parking-spot",
              "host": ["{{base_url}}"],
              "path": ["parking-spot"]
            }
          }
        },
        {
          "name": "Update Spot",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": {
              "raw": "{{base_url}}/parking-spot/{{spot_id}}",
              "host": ["{{base_url}}"],
              "path": ["parking-spot", "{{spot_id}}"]
            }
          }
        },
        {
          "name": "Delete Spot",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/parking-spot/{{spot_id}}",
              "host": ["{{base_url}}"],
              "path": ["parking-spot", "{{spot_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiclePlate\": \"1234ABC\",\n  \"date\": \"01/09/2026\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"12:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/reservation",
              "host": ["{{base_url}}"],
              "path": ["reservation"]
            }
          }
        },
        {
          "name": "Get All Reservations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reservation?limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["reservation"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "offset", "value": "0" },
                { "key": "date", "value": "01/09/2026", "disabled": true },
                { "key": "status", "value": "active", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Reservation by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reservation/{{reservation_id}}",
              "host": ["{{base_url}}"],
              "path": ["reservation", "{{reservation_id}}"]
            }
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reservation/{{reservation_id}}",
              "host": ["{{base_url}}"],
              "path": ["reservation", "{{reservation_id}}"]
            }
          }
        },
        {
          "name": "Mark as Arrived",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reservation/arrived/{{reservation_id}}",
              "host": ["{{base_url}}"],
              "path": ["reservation", "arrived", "{{reservation_id}}"]
            }
          }
        },
        {
          "name": "Mark as Done",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/reservation/done/{{reservation_id}}",
              "host": ["{{base_url}}"],
              "path": ["reservation", "done", "{{reservation_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Logs",
      "item": [
        {
          "name": "Get Activity Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logs?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["logs"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" },
                {
                  "key": "type",
                  "value": "reservation_created",
                  "disabled": true
                },
                { "key": "userId", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
